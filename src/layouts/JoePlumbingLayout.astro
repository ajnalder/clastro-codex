---
import '../styles/joe-plumbing.css';

interface Props {
  title: string;
  metaDescription: string;
  schema?: string;
  pageId: string;
  currentPath: string;
  editMode: boolean;
}

const { title, metaDescription, schema, pageId, currentPath } = Astro.props;
const navItems = [
  { href: '/joe-plumbing', label: 'Home' },
  { href: '/joe-plumbing/about', label: 'About' },
  { href: '/joe-plumbing/services', label: 'Services' },
  { href: '/joe-plumbing/blog', label: 'Blog' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    {schema && <script type="application/ld+json" set:html={schema} />}
  </head>
  <body class="joe-site">
    <div class="joe-edit-bar" data-joe-edit-root data-site-id="joes-plumbing" data-page-id={pageId} hidden>
      <a href={`/cms?view=pages&page=${pageId}`}>Back to CMS</a>
      <span data-joe-edit-status>Published</span>
      <button type="button" data-joe-publish disabled>Publish</button>
    </div>

    <div class="joe-edit-toolbar" data-joe-toolbar hidden aria-label="Page text formatting">
      <label class="joe-toolbar-select">
        <span>Element</span>
        <select data-editor-element aria-label="Element type">
          <option value="span">Inline text</option>
          <option value="strong">Strong text</option>
          <option value="p">Paragraph</option>
          <option value="h1">Heading 1</option>
          <option value="h2">Heading 2</option>
          <option value="h3">Heading 3</option>
          <option value="blockquote">Quote</option>
        </select>
      </label>
      <label class="joe-toolbar-select">
        <span>Size</span>
        <select data-editor-size aria-label="Visual size">
          <option value="default">Default</option>
          <option value="small">Small</option>
          <option value="large">Large</option>
        </select>
      </label>
      <div class="joe-toolbar-group" aria-label="Inline formatting">
        <button type="button" data-command="bold" title="Bold" aria-label="Bold">
          <strong aria-hidden="true">B</strong>
        </button>
        <button type="button" data-command="italic" title="Italic" aria-label="Italic">
          <em aria-hidden="true">I</em>
        </button>
        <button type="button" data-command="insertUnorderedList" title="Bulleted list" aria-label="Bulleted list">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="5" cy="7" r="1.4"></circle>
            <circle cx="5" cy="12" r="1.4"></circle>
            <circle cx="5" cy="17" r="1.4"></circle>
            <path d="M10 7h9M10 12h9M10 17h9"></path>
          </svg>
        </button>
        <button type="button" data-command="insertOrderedList" title="Numbered list" aria-label="Numbered list">
          <span aria-hidden="true">1.</span>
        </button>
      </div>
      <div class="joe-toolbar-group" aria-label="Links and history">
        <button type="button" data-command="createLink" title="Add link" aria-label="Add link">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9.6 14.4 14.4 9.6"></path>
            <path d="M11 6.8 12.7 5a4.2 4.2 0 0 1 5.9 5.9l-1.7 1.7"></path>
            <path d="m13 17.2-1.7 1.8a4.2 4.2 0 0 1-5.9-5.9l1.7-1.7"></path>
          </svg>
        </button>
        <button type="button" data-command="unlink" title="Remove link" aria-label="Remove link">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 7h1a4 4 0 0 1 0 8h-1"></path>
            <path d="M9 17H8a4 4 0 0 1 0-8h1"></path>
            <path d="m8 4 8 16"></path>
          </svg>
        </button>
        <button type="button" data-command="undo" title="Undo" aria-label="Undo">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 7 5 11l4 4"></path>
            <path d="M5 11h9a5 5 0 0 1 0 10h-1"></path>
          </svg>
        </button>
        <button type="button" data-command="redo" title="Redo" aria-label="Redo">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m15 7 4 4-4 4"></path>
            <path d="M19 11h-9a5 5 0 0 0 0 10h1"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="joe-link-editor" data-joe-link-editor hidden aria-label="Button link editor">
      <label>
        <span>Button text</span>
        <input type="text" data-link-label aria-label="Button text" />
      </label>
      <label>
        <span>Destination</span>
        <input type="text" data-link-href aria-label="Button destination" />
      </label>
    </div>

    <header class="joe-header">
      <a class="joe-brand" href="/joe-plumbing">
        <span>JP</span>
        <strong>Joe's Plumbing</strong>
      </a>
      <nav aria-label="Joe's Plumbing navigation">
        {navItems.map((item) => (
          <a class:list={{ 'is-active': currentPath === item.href }} href={item.href}>{item.label}</a>
        ))}
      </nav>
      <a class="joe-header-cta" href="tel:+6475550184">Call Joe</a>
    </header>

    <slot />

    <footer class="joe-footer">
      <div>
        <strong>Joe's Plumbing</strong>
        <p>Repairs, maintenance, and practical plumbing advice for Tauranga homes.</p>
      </div>
      <a href="/cms?view=pages&page=home">Open CMS</a>
    </footer>

    <script>
      import '../joe-plumbing/edit-mode';
    </script>
  </body>
</html>
