---
import { plumberContract } from '../contracts';
import { demoContentStore } from '../cms/demo-store';
import { demoSiteSettings, demoUsers, plumberItems, plumberMediaAssets, plumberPages } from '../cms/sample-content';
import { createCmsViewModel, type CmsFieldView } from '../cms/view-model';
import '../styles/cms.css';

export const prerender = false;

const selectedView = Astro.url.searchParams.get('view');
const selectedCollectionId = Astro.url.searchParams.get('collection') ?? undefined;
const selectedItemId = Astro.url.searchParams.get('item') ?? undefined;
const selectedPageId = Astro.url.searchParams.get('page') ?? undefined;
const mode =
  selectedView === 'media'
    ? 'media'
    : selectedView === 'ai'
    ? 'ai'
    : selectedView === 'settings'
    ? 'settings'
    : selectedView === 'users'
    ? 'users'
    : selectedView === 'pages' || selectedPageId
    ? 'pages'
    : 'collections';
const selectedCollectionForDraft = selectedCollectionId ?? plumberContract.collections[0]?.id;
const selectedItemForDraft =
  selectedItemId ?? plumberItems.find((item) => item.collectionId === selectedCollectionForDraft)?.itemId;
const draftItem = selectedCollectionForDraft && selectedItemForDraft
  ? await demoContentStore.getDraftItem('joes-plumbing', selectedCollectionForDraft, selectedItemForDraft)
  : null;
const items = draftItem
  ? plumberItems.map((item) =>
      item.collectionId === draftItem.collectionId && item.itemId === draftItem.itemId
        ? {
            collectionId: draftItem.collectionId,
            itemId: draftItem.itemId,
            label: item.label,
            status: draftItem.status,
            values: draftItem.values,
            extraSections: draftItem.extraSections,
          }
        : item,
    )
  : plumberItems;
const storedMediaAssets = await demoContentStore.listMediaAssets('joes-plumbing');
const storedMediaAssetIds = new Set(storedMediaAssets.map((asset) => asset.assetId));
const mediaAssets = [
  ...storedMediaAssets,
  ...plumberMediaAssets.filter((asset) => !storedMediaAssetIds.has(asset.assetId)),
];

const model = createCmsViewModel(plumberContract, items, {
  mode,
  selectedCollectionId,
  selectedItemId: selectedItemForDraft,
  selectedPageId,
}, plumberPages, mediaAssets, {
  siteSettings: demoSiteSettings,
  users: demoUsers,
  currentUserId: 'andrew-nalder',
});

const activeCollection = model.activeCollection;
const activeItem = model.activeItem;
const activePage = model.activePage;
const isPagesMode = model.activeMode === 'pages';
const isMediaMode = model.activeMode === 'media';
const isAiMode = model.activeMode === 'ai';
const isSettingsMode = model.activeMode === 'settings';
const isUsersMode = model.activeMode === 'users';
const activeStatus = isPagesMode ? activePage?.status : activeItem?.status;
const statusLabel =
  isMediaMode
    ? 'Media library'
    : isAiMode
    ? 'AI integration'
    : isSettingsMode
    ? 'Site settings'
    : isUsersMode
    ? 'User access'
    : activeStatus === 'published'
    ? 'Published'
    : 'Saved draft';
const mediaLibraryJson = JSON.stringify(model.mediaAssets);
const currentUser = model.auth.currentUser;
const isBlogWorkspace = model.blogWorkspace.visible;
const activeBlogPost = model.blogWorkspace.activePost;

const multilinePrimitives = new Set(['richText', 'longText', 'seoMetadata', 'table', 'faqList', 'callout']);

function isMultiline(field: CmsFieldView) {
  return multilinePrimitives.has(field.primitive);
}

function isImageField(field: CmsFieldView) {
  return field.primitive === 'image';
}

function isGalleryField(field: CmsFieldView) {
  return field.primitive === 'imageGallery' || field.primitive === 'sortableGallery';
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Clastro CMS</title>
  </head>
  <body>
    <main class="cms-shell" data-cms-root data-editor-mode={model.activeMode} data-media-library={mediaLibraryJson}>
      <aside class="cms-sidebar" aria-label="CMS navigation">
        <a class="cms-brand" href="/">
          <span class="cms-logo-panel">
            <img class="cms-brand-logo" src="/images/clastro-logo.svg" alt="Clastro CMS" />
          </span>
          <span>
            <small>Structured editor</small>
          </span>
        </a>

        <nav class="cms-nav" aria-label="Pages">
          <p class="cms-kicker">Pages</p>
          {model.pageNavigation.map((page) => (
            <a class:list={['cms-nav-item', { 'is-active': page.active }]} href={`/cms?view=pages&page=${page.id}`}>
              <span>{page.label}</span>
              <small>{page.path}</small>
            </a>
          ))}
        </nav>

        <nav class="cms-nav" aria-label="Collections">
          <p class="cms-kicker">Collections</p>
          {model.navigation.map((item) => (
            <a class:list={['cms-nav-item', { 'is-active': item.active }]} href={`/cms?collection=${item.id}`}>
              <span>{item.label}</span>
              <small>{item.itemCount}</small>
            </a>
          ))}
        </nav>

        <nav class="cms-nav" aria-label="Media">
          <p class="cms-kicker">Assets</p>
          <a class:list={['cms-nav-item', { 'is-active': isMediaMode }]} href="/cms?view=media">
            <span>Media</span>
            <small data-media-count>{model.mediaAssets.length}</small>
          </a>
        </nav>

        <nav class="cms-nav" aria-label="Admin">
          <p class="cms-kicker">Admin</p>
          {model.ai.visible && (
            <a class:list={['cms-nav-item', { 'is-active': isAiMode }]} href="/cms?view=ai">
              <span>AI Integration</span>
              <small>{model.ai.apiKeyStatusLabel}</small>
            </a>
          )}
          <a class:list={['cms-nav-item', { 'is-active': isSettingsMode }]} href="/cms?view=settings">
            <span>Settings</span>
            <small>site</small>
          </a>
          <a class:list={['cms-nav-item', { 'is-active': isUsersMode }]} href="/cms?view=users">
            <span>Users</span>
            <small>{model.auth.users.length}</small>
          </a>
        </nav>

        {currentUser && (
          <div class="cms-user-badge">
            <p class="cms-kicker">Signed in</p>
            <strong>{currentUser.name}</strong>
            <span>{currentUser.roleLabel}</span>
          </div>
        )}

        <div class="cms-sidebar-note">
          <p class="cms-kicker">Framework rule</p>
          <p>The backend follows the client’s business language while the content contract keeps the plumbing consistent.</p>
        </div>
      </aside>

      <section class="cms-list" aria-label={isMediaMode ? 'Media assets' : isAiMode ? 'AI integration' : isPagesMode ? 'Pages' : isSettingsMode ? 'Settings' : isUsersMode ? 'Users' : isBlogWorkspace ? 'Blog posts' : 'Collection items'}>
        {isMediaMode ? (
          <>
            <div class="cms-section-heading">
              <p class="cms-kicker">Media</p>
              <h1>Assets</h1>
              <p>Optimized images stored for website use.</p>
            </div>

            <div class="cms-item-list" data-media-asset-list>
              {model.mediaAssets.map((asset) => (
                <a class="cms-item-row" href={`#media-${asset.assetId}`} data-media-asset-row={asset.assetId}>
                  <span>
                    <strong>{asset.filename}</strong>
                    <small>{asset.width} x {asset.height}</small>
                  </span>
                  <em>{asset.largeBytesLabel}</em>
                </a>
              ))}
            </div>
          </>
        ) : isAiMode ? (
          <>
            <div class="cms-section-heading">
              <p class="cms-kicker">AI</p>
              <h1>Integration</h1>
              <p>OpenAI connection and blog generation access for this site.</p>
            </div>

            <div class="cms-item-list">
              <a class="cms-item-row is-active" href="/cms?view=ai">
                <span>
                  <strong>OpenAI</strong>
                  <small>{model.ai.apiKeyStatusLabel}</small>
                </span>
                <em>AI</em>
              </a>
              <a class="cms-item-row" href="/cms?collection=blogPosts">
                <span>
                  <strong>Blog posts</strong>
                  <small>{model.ai.canGenerateBlogPosts ? 'Generation enabled' : 'Generation hidden'}</small>
                </span>
                <em>blog</em>
              </a>
            </div>
          </>
        ) : isSettingsMode ? (
          <>
            <div class="cms-section-heading">
              <p class="cms-kicker">Site admin</p>
              <h1>Settings</h1>
              <p>Business, access, and integration settings for this site.</p>
            </div>

            <div class="cms-item-list">
              <a class="cms-item-row is-active" href="/cms?view=settings">
                <span>
                  <strong>Site profile</strong>
                  <small>{model.siteSettings?.domain}</small>
                </span>
                <em>settings</em>
              </a>
              <a class="cms-item-row" href="/cms?view=users">
                <span>
                  <strong>User access</strong>
                  <small>{model.auth.users.length} visible users</small>
                </span>
                <em>users</em>
              </a>
            </div>
          </>
        ) : isUsersMode ? (
          <>
            <div class="cms-section-heading">
              <p class="cms-kicker">Access</p>
              <h1>Users</h1>
              <p>Owners, editors, collaborators, and visible support access.</p>
            </div>

            <div class="cms-item-list">
              {model.auth.users.map((user) => (
                <a class="cms-item-row" href={`#user-${user.userId}`}>
                  <span>
                    <strong>{user.name}</strong>
                    <small>{user.email}</small>
                  </span>
                  <em>{user.roleLabel}</em>
                </a>
              ))}
            </div>
          </>
        ) : isPagesMode ? (
          <>
            <div class="cms-section-heading">
              <p class="cms-kicker">Static pages</p>
              <h1>Pages</h1>
              <p>Page names, SEO metadata, schema, and access to visual editing.</p>
            </div>

            <div class="cms-item-list">
              {model.pageNavigation.map((page) => (
                <a class:list={['cms-item-row', { 'is-active': page.active }]} href={`/cms?view=pages&page=${page.id}`}>
                  <span>
                    <strong>{page.label}</strong>
                    <small>{page.path}</small>
                  </span>
                  <em>{page.active && activePage ? activePage.status : 'page'}</em>
                </a>
              ))}
            </div>
          </>
        ) : isBlogWorkspace ? (
          <>
            <div class="cms-section-heading">
              <p class="cms-kicker">Blog posts</p>
              <h1>Articles</h1>
              <p>Draft, review, and publish blog content from a writing-focused workspace.</p>
            </div>

            <div class="cms-blog-list-tools">
              <label class="cms-field">
                <span>Search posts</span>
                <input class="cms-input" type="search" placeholder="Search by title or excerpt" />
              </label>
              <label class="cms-field">
                <span>Sort</span>
                <select class="cms-input">
                  <option>Newest first</option>
                  <option>Title A-Z</option>
                  <option>Published first</option>
                </select>
              </label>
            </div>

            <div class="cms-blog-post-list">
              {model.blogWorkspace.posts.map((post) => (
                <a class:list={['cms-blog-post-row', { 'is-active': post.active }]} href={`/cms?collection=blogPosts&item=${post.id}`}>
                  <span class="cms-blog-post-thumb">
                    {post.mediaAsset ? (
                      <img src={post.mediaAsset.previewUrl} alt={post.mediaAsset.altText} width={post.mediaAsset.previewWidth} height={post.mediaAsset.previewHeight} />
                    ) : (
                      <i data-lucide="file-text"></i>
                    )}
                  </span>
                  <span class="cms-blog-post-row-copy">
                    <strong>{post.title}</strong>
                    <small>{post.excerpt || post.publishDate || post.id}</small>
                  </span>
                  <em>{post.status}</em>
                </a>
              ))}
            </div>
          </>
        ) : (
          <>
            <div class="cms-section-heading">
              <p class="cms-kicker">Active collection</p>
              <h1>{activeCollection?.label ?? 'Collection'}</h1>
              <p>{activeCollection?.itemLabel ?? 'Item'} records generated from the content contract.</p>
            </div>

            <div class="cms-item-list">
              {activeCollection?.items.map((item) => (
                <a class:list={['cms-item-row', { 'is-active': item.active }]} href={`/cms?collection=${activeCollection.id}&item=${item.id}`}>
                  <span>
                    <strong>{item.label}</strong>
                    <small>{item.id}</small>
                  </span>
                  <em>{item.status}</em>
                </a>
              ))}
            </div>
          </>
        )}
      </section>

      <section class="cms-editor" aria-label={isMediaMode ? 'Media editor' : isAiMode ? 'AI integration editor' : isBlogWorkspace ? 'Blog post editor' : isSettingsMode ? 'Settings editor' : isUsersMode ? 'Users editor' : isPagesMode ? 'Page editor' : 'Item editor'}>
        <header class="cms-editor-header">
          <div>
            <p class="cms-kicker">{isMediaMode ? 'Media library' : isAiMode ? 'AI Integration' : isBlogWorkspace ? 'Writing workspace' : isSettingsMode ? 'Site admin' : isUsersMode ? 'Access control' : isPagesMode ? 'Page settings' : 'Editing globally'}</p>
            <h2>{isMediaMode ? 'Website images' : isAiMode ? 'OpenAI blog assistant' : isBlogWorkspace ? activeBlogPost?.title || 'Blog post' : isSettingsMode ? model.siteSettings?.siteName ?? 'Site settings' : isUsersMode ? 'Users and roles' : isPagesMode ? activePage?.label ?? 'Select a page' : activeItem?.label ?? 'Select an item'}</h2>
            <p>
              {isMediaMode
                ? 'Upload optimized images, add alt text, and manage captions.'
                : isAiMode
                ? 'Connect the client’s own OpenAI API key and decide whether blog generation is available.'
                : isBlogWorkspace
                ? 'Write the article, manage the cover image, review SEO metadata, and publish when ready.'
                : isSettingsMode
                ? 'Core business, domain, support access, analytics, and search settings.'
                : isUsersMode
                ? 'Manage the people who can log in and edit this site.'
                : isPagesMode
                ? activePage?.path
                : `${activeCollection?.label} / ${activeItem?.id}`}
            </p>
          </div>
          <div class="cms-editor-actions">
            {isBlogWorkspace && model.blogWorkspace.canUseAiDraftBuilder && (
              <a class="cms-button cms-button-secondary" href="#ai-draft-builder">
                <i data-lucide="sparkles"></i>
                <span>AI Draft</span>
              </a>
            )}
            {model.ai.blogGenerationVisible && !isBlogWorkspace && (
              <a class="cms-button cms-button-secondary" href="/cms?view=ai">
                <i data-lucide="sparkles"></i>
                <span>Generate AI Blog Post</span>
              </a>
            )}
            {isPagesMode && activePage && <a class="cms-button cms-button-secondary" href={activePage.editHref}>Edit page</a>}
            <div class="cms-status-pill" data-status-pill>{statusLabel}</div>
          </div>
        </header>

        {isMediaMode && (
          <form class="cms-form cms-media-form" data-media-form>
            <section class="cms-upload-panel">
              <div>
                <p class="cms-kicker">Optimized upload</p>
                <h3>Add website image</h3>
                <p>JPEG, PNG, or WebP images are converted into optimized WebP variants before storage.</p>
              </div>
              <label class="cms-field" for="media-upload">
                <span>Image file</span>
                <input class="cms-input" id="media-upload" type="file" accept="image/jpeg,image/png,image/webp" data-media-upload />
              </label>
              <label class="cms-field" for="media-alt">
                <span>Alt text <em>Required</em></span>
                <input class="cms-input" id="media-alt" data-media-alt />
              </label>
              <label class="cms-field" for="media-caption">
                <span>Caption</span>
                <input class="cms-input" id="media-caption" data-media-caption />
              </label>
              <button class="cms-button" type="button" data-media-upload-button>Upload optimized image</button>
            </section>

            <section class="cms-field-section">
              <div class="cms-subheading">
                <p class="cms-kicker">Library</p>
                <h3>Website images</h3>
              </div>
              <div class="cms-media-grid">
                {model.mediaAssets.map((asset) => (
                  <article class="cms-media-card" id={`media-${asset.assetId}`} data-media-asset={asset.assetId}>
                    <img class="cms-media-preview" src={asset.previewUrl} alt={asset.altText} width={asset.previewWidth} height={asset.previewHeight} />
                    <label class="cms-field">
                      <span>Alt text</span>
                      <input class="cms-input" value={asset.altText} data-media-asset-alt={asset.assetId} />
                    </label>
                    <label class="cms-field">
                      <span>Caption</span>
                      <input class="cms-input" value={asset.caption} data-media-asset-caption={asset.assetId} />
                    </label>
                    <dl class="cms-media-meta">
                      <div><dt>Size</dt><dd>{asset.width} x {asset.height}</dd></div>
                      <div><dt>Large</dt><dd>{asset.largeBytesLabel}</dd></div>
                    </dl>
                  </article>
                ))}
              </div>
            </section>
          </form>
        )}

        {isAiMode && (
          <form class="cms-form">
            {model.ai.visible ? (
              <>
                <section class="cms-field-section" aria-labelledby="ai-integration-heading">
                  <div class="cms-subheading">
                    <p class="cms-kicker">Provider</p>
                    <h3 id="ai-integration-heading">OpenAI connection</h3>
                  </div>

                  <div class="cms-settings-grid">
                    <label class="cms-field">
                      <span>Provider</span>
                      <input class="cms-input" value={model.ai.providerLabel} readonly />
                      <small>Blog generation uses the client’s own OpenAI account and key.</small>
                    </label>
                    <label class="cms-field">
                      <span>API key status</span>
                      <input class="cms-input" value={model.ai.apiKeyStatusLabel} readonly />
                      <small>The actual key is never displayed after it is saved.</small>
                    </label>
                    <label class="cms-field cms-field-wide">
                      <span>API key</span>
                      <input class="cms-input" type="password" placeholder="sk-..." autocomplete="off" disabled={!model.ai.canManageIntegration} />
                      <small>{model.ai.canManageIntegration ? 'Save or replace the OpenAI API key for this site.' : 'Only Clastro support can add or replace the API key.'}</small>
                    </label>
                    <button class="cms-button" type="button" disabled={!model.ai.canManageIntegration}>Save API key</button>
                  </div>
                </section>

                <section class="cms-field-section" aria-labelledby="ai-blog-access-heading">
                  <div class="cms-subheading">
                    <p class="cms-kicker">Blog generation</p>
                    <h3 id="ai-blog-access-heading">Visibility and access</h3>
                  </div>

                  <div class="cms-settings-grid">
                    <article class="cms-setting-card">
                      <span>Feature visibility</span>
                      <strong>{model.ai.blogGenerationEnabled ? 'Enabled for allowed users' : 'Hidden from client users'}</strong>
                      <small>When hidden, the AI section and Generate AI Blog Post controls do not appear for owners, editors, or collaborators.</small>
                    </article>
                    <article class="cms-setting-card">
                      <span>Current user</span>
                      <strong>{model.ai.canGenerateBlogPosts ? 'Can generate blog posts' : 'Cannot generate blog posts'}</strong>
                      <small>Procedure, service, and product pages stay manual; AI assistance is scoped to blog content only.</small>
                    </article>
                    <article class="cms-setting-card">
                      <span>Managed by</span>
                      <strong>{model.ai.canManageIntegration ? 'Clastro super admin' : 'Clastro support'}</strong>
                      <small>Andrew can decide which client users see the AI blog workflow when setting up access.</small>
                    </article>
                  </div>
                </section>
              </>
            ) : (
              <div class="cms-empty-state">
                <strong>AI blog generation is not available for this user.</strong>
                <p>The integration and blog generation tools are hidden unless Clastro enables access for this login.</p>
              </div>
            )}
          </form>
        )}

        {isSettingsMode && model.siteSettings && (
          <form class="cms-form">
            <section class="cms-field-section" aria-labelledby="site-settings-heading">
              <div class="cms-subheading">
                <p class="cms-kicker">Site profile</p>
                <h3 id="site-settings-heading">Business details</h3>
              </div>

              <div class="cms-settings-grid">
                <label class="cms-field">
                  <span>Site name</span>
                  <input class="cms-input" value={model.siteSettings.siteName} />
                  <small>Shown in the CMS and internal site switcher.</small>
                </label>
                <label class="cms-field">
                  <span>Business name</span>
                  <input class="cms-input" value={model.siteSettings.businessName} />
                  <small>Used for schema, invoices, and support context.</small>
                </label>
                <label class="cms-field">
                  <span>Primary domain</span>
                  <input class="cms-input" value={model.siteSettings.domain} />
                  <small>The public domain for published pages.</small>
                </label>
              </div>
            </section>

            <section class="cms-field-section" aria-labelledby="integration-settings-heading">
              <div class="cms-subheading">
                <p class="cms-kicker">Integrations</p>
                <h3 id="integration-settings-heading">Analytics and search</h3>
              </div>

              <div class="cms-settings-grid">
                <div class="cms-setting-card">
                  <span>Google Analytics</span>
                  <strong>{model.siteSettings.analyticsProperty}</strong>
                  <small>For traffic, events, conversions, and page performance inside the CMS.</small>
                </div>
                <div class="cms-setting-card">
                  <span>Google Search Console</span>
                  <strong>{model.siteSettings.searchConsoleProperty}</strong>
                  <small>For SEO visibility, query data, indexed pages, and opportunities.</small>
                </div>
                <div class="cms-setting-card">
                  <span>Support access</span>
                  <strong>{model.siteSettings.supportAccessVisible ? 'Visible to client users' : 'Hidden from client users'}</strong>
                  <small>Your super admin account is displayed in Users so support access is transparent.</small>
                </div>
              </div>
            </section>
          </form>
        )}

        {isUsersMode && (
          <form class="cms-form">
            <section class="cms-field-section" aria-labelledby="user-access-heading">
              <div class="cms-subheading">
                <p class="cms-kicker">People</p>
                <h3 id="user-access-heading">User access</h3>
              </div>

              <div class="cms-user-grid">
                {model.auth.users.map((user) => (
                  <article class:list={['cms-user-card', { 'is-support': user.role === 'superAdmin' }]} id={`user-${user.userId}`}>
                    <div>
                      <span>{user.accessLabel}</span>
                      <h4>{user.name}</h4>
                      <p>{user.email}</p>
                    </div>
                    <dl class="cms-user-meta">
                      <div><dt>Role</dt><dd>{user.roleLabel}</dd></div>
                      <div><dt>Status</dt><dd>{user.status}</dd></div>
                      <div><dt>AI blogs</dt><dd>{user.aiBlogGenerationLabel}</dd></div>
                      <div><dt>Manage</dt><dd>{user.canBeManagedByCurrentUser ? 'Allowed' : 'Locked'}</dd></div>
                    </dl>
                  </article>
                ))}
              </div>
            </section>

            <section class="cms-field-section" aria-labelledby="invite-user-heading">
              <div class="cms-subheading">
                <p class="cms-kicker">Invite</p>
                <h3 id="invite-user-heading">Add user</h3>
              </div>

              {model.auth.canManageUsers ? (
                <div class="cms-settings-grid">
                  <label class="cms-field">
                    <span>Name</span>
                    <input class="cms-input" placeholder="New user name" />
                  </label>
                  <label class="cms-field">
                    <span>Email</span>
                    <input class="cms-input" placeholder="name@example.com" />
                  </label>
                  <label class="cms-field">
                    <span>Role</span>
                    <select class="cms-input">
                      {model.auth.inviteRoles.map((role) => (
                        <option value={role}>{role === 'siteOwner' ? 'Site owner' : role === 'editor' ? 'Editor' : 'Collaborator'}</option>
                      ))}
                    </select>
                  </label>
                  {model.ai.canManageIntegration && (
                    <label class="cms-setting-card cms-check-card">
                      <input type="checkbox" checked />
                      <span>AI blog generation</span>
                      <strong>Show AI tools for this user</strong>
                      <small>Turn this off when a client uses an external SEO writer and should not see blog generation.</small>
                    </label>
                  )}
                  <button class="cms-button" type="button">Send invite</button>
                </div>
              ) : (
                <div class="cms-empty-state">
                  <strong>You cannot manage users.</strong>
                  <p>Only the site owner and Clastro super admin can invite or change users.</p>
                </div>
              )}
            </section>
          </form>
        )}

        {isPagesMode && activePage && (
          <form class="cms-form" data-editor-form>
            <section class="cms-field-section" aria-labelledby="page-fields-heading">
              <div class="cms-subheading">
                <p class="cms-kicker">Page settings</p>
                <h3 id="page-fields-heading">SEO and schema</h3>
              </div>

              <div class="cms-fields">
                {activePage.fields.map((field) => (
                  <label class="cms-field" for={`page-${field.id}`}>
                    <span>
                      {field.label}
                      {field.required && <em>Required</em>}
                    </span>
                    {isMultiline(field) ? (
                      <textarea
                        class="cms-input cms-textarea"
                        id={`page-${field.id}`}
                        name={`page-${field.id}`}
                        aria-label={field.label}
                        data-page-field={field.id}
                      >{field.value}</textarea>
                    ) : (
                      <input
                        class="cms-input"
                        id={`page-${field.id}`}
                        name={`page-${field.id}`}
                        aria-label={field.label}
                        value={field.value}
                        data-page-field={field.id}
                      />
                    )}
                    <small>{field.primitive}</small>
                  </label>
                ))}
              </div>
            </section>
          </form>
        )}

        {isBlogWorkspace && activeBlogPost && (
          <form class="cms-blog-workspace" data-editor-form data-collection-id="blogPosts" data-item-id={activeBlogPost.id}>
            {model.blogWorkspace.canUseAiDraftBuilder && (
              <section class="cms-ai-draft-card" id="ai-draft-builder">
                <div class="cms-subheading">
                  <p class="cms-kicker">AI Draft Builder</p>
                  <h3>Start from a brief, then edit the draft.</h3>
                </div>
                <div class="cms-blog-grid">
                  <label class="cms-field cms-field-wide">
                    <span>Topic or brief</span>
                    <textarea class="cms-input cms-textarea" placeholder="Example: Write a practical homeowner guide about shutting off water during a plumbing emergency."></textarea>
                    <small>Use this to create title ideas or a first draft. The generated draft still needs review before publishing.</small>
                  </label>
                  <label class="cms-field">
                    <span>Audience</span>
                    <input class="cms-input" value="Tauranga homeowners" />
                  </label>
                  <label class="cms-field">
                    <span>Goal</span>
                    <input class="cms-input" value="Explain clearly and encourage a next step" />
                  </label>
                  <label class="cms-field cms-field-wide">
                    <span>Selected title</span>
                    <input class="cms-input" placeholder="Optional. Leave blank to let AI suggest one." />
                  </label>
                  <label class="cms-check-card cms-setting-card cms-field-wide">
                    <input type="checkbox" checked />
                    <span>Cover image</span>
                    <strong>Generate a cover image and alt text</strong>
                    <small>Images generated or uploaded here should still be optimized and stored in Media.</small>
                  </label>
                </div>
                <div class="cms-button-row">
                  <button class="cms-button cms-button-secondary" type="button">Get 5 Titles</button>
                  <button class="cms-button" type="button">Generate Draft</button>
                </div>
              </section>
            )}

            <section class="cms-blog-editor-card">
              <div class="cms-blog-editor-bar">
                <div>
                  <p class="cms-kicker">{activeBlogPost.id ? 'Editing post' : 'New post'}</p>
                  <h3>{activeBlogPost.title || 'Untitled blog post'}</h3>
                </div>
                <div class="cms-editor-actions">
                  <label class="cms-publish-toggle">
                    <input type="checkbox" checked={activeBlogPost.status === 'published'} />
                    <span>Published</span>
                  </label>
                  <button class="cms-button cms-button-secondary" type="button">Save Draft</button>
                  <button class="cms-button" type="button" disabled>Publish</button>
                </div>
              </div>

              <div class="cms-blog-grid">
                {activeBlogPost.titleField && (
                  <label class="cms-field cms-field-wide" for={`blog-${activeBlogPost.titleField.id}`}>
                    <span>Title</span>
                    <input class="cms-input cms-blog-title-input" id={`blog-${activeBlogPost.titleField.id}`} value={activeBlogPost.titleField.value} data-field={activeBlogPost.titleField.id} />
                    <small>Shown as the article heading and used as the default slug source.</small>
                  </label>
                )}
                {activeBlogPost.slugField && (
                  <label class="cms-field" for={`blog-${activeBlogPost.slugField.id}`}>
                    <span>Slug</span>
                    <input class="cms-input" id={`blog-${activeBlogPost.slugField.id}`} value={activeBlogPost.slugField.value} data-field={activeBlogPost.slugField.id} />
                    <small>Used in the post URL.</small>
                  </label>
                )}
                {activeBlogPost.publishDateField && (
                  <label class="cms-field" for={`blog-${activeBlogPost.publishDateField.id}`}>
                    <span>Publish date</span>
                    <input class="cms-input" id={`blog-${activeBlogPost.publishDateField.id}`} value={activeBlogPost.publishDateField.value} data-field={activeBlogPost.publishDateField.id} />
                  </label>
                )}
                {activeBlogPost.excerptField && (
                  <label class="cms-field cms-field-wide" for={`blog-${activeBlogPost.excerptField.id}`}>
                    <span>Excerpt</span>
                    <textarea class="cms-input cms-textarea" id={`blog-${activeBlogPost.excerptField.id}`} data-field={activeBlogPost.excerptField.id}>{activeBlogPost.excerptField.value}</textarea>
                    <small>Used on blog cards, previews, and sometimes as fallback meta copy.</small>
                  </label>
                )}

                {activeBlogPost.heroImageField && (
                  <div class="cms-field cms-blog-cover-field cms-field-wide" data-cms-field-shell={activeBlogPost.heroImageField.id}>
                    <span>Cover image</span>
                    <div class="cms-blog-cover-panel">
                      <div class="cms-blog-cover-preview" data-image-preview={activeBlogPost.heroImageField.id}>
                        {activeBlogPost.heroImageField.mediaAsset ? (
                          <img src={activeBlogPost.heroImageField.mediaAsset.previewUrl} alt={activeBlogPost.heroImageField.mediaAsset.altText} width={activeBlogPost.heroImageField.mediaAsset.previewWidth} height={activeBlogPost.heroImageField.mediaAsset.previewHeight} />
                        ) : (
                          <strong>No cover image selected</strong>
                        )}
                      </div>
                      <div class="cms-blog-cover-copy">
                        <strong>{activeBlogPost.heroImageField.mediaAsset?.filename ?? 'Choose a website image'}</strong>
                        <small>{activeBlogPost.heroImageField.mediaAsset?.altText ?? 'Upload or choose an optimized image from Media.'}</small>
                        <input type="hidden" name={`core-${activeBlogPost.heroImageField.id}`} value={JSON.stringify(activeBlogPost.heroImageField.imageValue)} data-field={activeBlogPost.heroImageField.id} data-media-image-field={activeBlogPost.heroImageField.id} />
                        <div class="cms-media-tools">
                          <button class="cms-icon-button cms-gallery-tool" type="button" title="Choose cover image" aria-label="Choose cover image" data-media-picker-open={activeBlogPost.heroImageField.id}>
                            <i data-lucide="plus"></i>
                          </button>
                          <label class="cms-icon-button cms-gallery-tool" title="Upload cover image">
                            <input class="cms-file-input" type="file" accept="image/jpeg,image/png,image/webp" data-media-field-upload={activeBlogPost.heroImageField.id} aria-label="Upload cover image" />
                            <i data-lucide="upload"></i>
                            <span class="cms-visually-hidden">Upload cover image</span>
                          </label>
                          <div class="cms-media-picker" data-media-picker={activeBlogPost.heroImageField.id} hidden>
                            <label class="cms-picker-search">
                              <span>Media library</span>
                              <input class="cms-input" type="search" placeholder="Search media" data-media-picker-search={activeBlogPost.heroImageField.id} />
                            </label>
                            <div class="cms-picker-list" data-media-picker-list={activeBlogPost.heroImageField.id}>
                              {model.mediaAssets.map((asset) => (
                                <button class="cms-picker-option" type="button" data-media-picker-select={activeBlogPost.heroImageField?.id} data-media-picker-asset={asset.assetId}>
                                  <img src={asset.previewUrl} alt={asset.altText} width={asset.previewWidth} height={asset.previewHeight} />
                                  <span>
                                    <strong>{asset.filename}</strong>
                                    <small>{asset.altText}</small>
                                  </span>
                                </button>
                              ))}
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                )}

                {activeBlogPost.seoField && (
                  <label class="cms-field cms-field-wide" for={`blog-${activeBlogPost.seoField.id}`}>
                    <span>SEO metadata</span>
                    <textarea class="cms-input cms-textarea" id={`blog-${activeBlogPost.seoField.id}`} data-field={activeBlogPost.seoField.id}>{activeBlogPost.seoField.value}</textarea>
                    <small>Used for search snippets, social previews, and future SEO opportunity tooling.</small>
                  </label>
                )}

                {activeBlogPost.bodyField && (
                  <label class="cms-field cms-field-wide" for={`blog-${activeBlogPost.bodyField.id}`}>
                    <span>Article body</span>
                    <div class="cms-richtext-toolbar">
                      <select class="cms-input" data-richtext-media-select={activeBlogPost.bodyField.id} aria-label="Insert image into article body">
                        <option value="">Insert image from media</option>
                        {model.mediaAssets.map((asset) => (
                          <option value={asset.assetId}>{asset.filename}</option>
                        ))}
                      </select>
                      <button class="cms-button cms-button-secondary" type="button" data-richtext-insert-image={activeBlogPost.bodyField.id}>Insert image</button>
                    </div>
                    <textarea class="cms-input cms-textarea cms-blog-body-editor" id={`blog-${activeBlogPost.bodyField.id}`} data-field={activeBlogPost.bodyField.id}>{activeBlogPost.bodyField.value}</textarea>
                  </label>
                )}
              </div>
            </section>
          </form>
        )}

        {!isPagesMode && !isBlogWorkspace && activeItem && (
          <form class="cms-form" data-editor-form data-collection-id={activeCollection?.id} data-item-id={activeItem.id}>
            <section class="cms-field-section" aria-labelledby="core-fields-heading">
              <div class="cms-subheading">
                <p class="cms-kicker">Core schema</p>
                <h3 id="core-fields-heading">Shared fields</h3>
              </div>

              <div class="cms-fields">
                {activeItem.fields.map((field) => (
                  isImageField(field) ? (
                    <div class="cms-field cms-media-field" data-cms-field-shell={field.id}>
                      <span>
                        {field.label}
                        {field.required && <em>Required</em>}
                      </span>
                      <div class="cms-media-field-preview" data-image-preview={field.id}>
                        {field.mediaAsset ? (
                          <>
                            <img src={field.mediaAsset.previewUrl} alt={field.mediaAsset.altText} width={field.mediaAsset.previewWidth} height={field.mediaAsset.previewHeight} />
                            <button
                              class="cms-icon-button cms-media-field-action"
                              type="button"
                              title="Remove image"
                              aria-label={`Remove ${field.mediaAsset.filename}`}
                              data-media-field-remove={field.id}
                            >
                              <i data-lucide="trash-2"></i>
                            </button>
                            <div class="cms-media-field-caption">
                              <strong>{field.mediaAsset.filename}</strong>
                              <small>{field.mediaAsset.altText}</small>
                            </div>
                          </>
                        ) : (
                          <strong>No image selected</strong>
                      )}
                      </div>
                      <input type="hidden" name={`core-${field.id}`} value={JSON.stringify(field.imageValue)} data-field={field.id} data-media-image-field={field.id} />
                      <div class="cms-media-tools">
                        <button class="cms-icon-button cms-gallery-tool" type="button" title="Choose image" aria-label={`Choose image for ${field.label}`} data-media-picker-open={field.id}>
                          <i data-lucide="plus"></i>
                        </button>
                        <label class="cms-icon-button cms-gallery-tool" title="Upload image">
                          <input class="cms-file-input" type="file" accept="image/jpeg,image/png,image/webp" data-media-field-upload={field.id} aria-label={`Upload ${field.label}`} />
                          <i data-lucide="upload"></i>
                          <span class="cms-visually-hidden">Upload image</span>
                        </label>
                        <div class="cms-media-picker" data-media-picker={field.id} hidden>
                          <label class="cms-picker-search">
                            <span>Media library</span>
                            <input class="cms-input" type="search" placeholder="Search media" data-media-picker-search={field.id} />
                          </label>
                          <div class="cms-picker-list" data-media-picker-list={field.id}>
                            {model.mediaAssets.map((asset) => (
                              <button class="cms-picker-option" type="button" data-media-picker-select={field.id} data-media-picker-asset={asset.assetId}>
                                <img src={asset.previewUrl} alt={asset.altText} width={asset.previewWidth} height={asset.previewHeight} />
                                <span>
                                  <strong>{asset.filename}</strong>
                                  <small>{asset.altText}</small>
                                </span>
                              </button>
                            ))}
                          </div>
                        </div>
                      </div>
                      <small class="cms-gallery-helper" data-media-file-name={field.id}>Uploaded images are optimized and selected immediately.</small>
                      <small>{field.primitive}</small>
                    </div>
                  ) : isGalleryField(field) ? (
                    <div
                      class="cms-field cms-gallery-field"
                      data-cms-field-shell={field.id}
                      data-gallery-sync-image-field={activeItem.fields.some((candidate) => candidate.id === 'heroImage') ? 'heroImage' : undefined}
                    >
                      <span>
                        {field.label}
                        {field.required && <em>Required</em>}
                      </span>
                      <input type="hidden" name={`core-${field.id}`} value={JSON.stringify(field.galleryValue)} data-field={field.id} data-media-gallery-field={field.id} />
                      <div class="cms-gallery-grid" data-gallery-preview={field.id}>
                        {field.gallery?.assets.map((asset) => (
                          <article
                            class:list={['cms-gallery-item', { 'is-hero': asset.assetId === field.gallery?.heroAssetId }]}
                            data-gallery-asset={asset.assetId}
                            draggable="true"
                            tabindex="0"
                            aria-label={`Gallery image: ${asset.filename}`}
                          >
                            <span class="cms-gallery-drag" aria-hidden="true"><i data-lucide="grip-vertical"></i></span>
                            <img src={asset.previewUrl} alt={asset.altText} width={asset.previewWidth} height={asset.previewHeight} />
                            <div class="cms-gallery-item-footer">
                              <strong>{asset.filename}</strong>
                              {asset.assetId === field.gallery?.heroAssetId && <span>Hero</span>}
                            </div>
                            <div class="cms-gallery-actions" aria-label={`${asset.filename} actions`}>
                              <button
                                class:list={['cms-icon-button', 'cms-gallery-action', { 'is-active': asset.assetId === field.gallery?.heroAssetId }]}
                                type="button"
                                title="Make hero image"
                                aria-label={`Make ${asset.filename} the hero image`}
                                data-gallery-set-hero={field.id}
                                data-gallery-asset-id={asset.assetId}
                              >
                                <i data-lucide="star"></i>
                              </button>
                              <button
                                class="cms-icon-button cms-gallery-action"
                                type="button"
                                title="Remove image"
                                aria-label={`Remove ${asset.filename} from gallery`}
                                data-gallery-remove={field.id}
                                data-gallery-asset-id={asset.assetId}
                              >
                                <i data-lucide="trash-2"></i>
                              </button>
                            </div>
                          </article>
                        ))}
                      </div>
                      <div class="cms-gallery-tools">
                        <button class="cms-icon-button cms-gallery-tool" type="button" title="Add image from media" aria-label="Add image from media" data-gallery-picker-open={field.id}>
                          <i data-lucide="plus"></i>
                        </button>
                        <label class="cms-icon-button cms-gallery-tool" title="Upload image">
                          <input class="cms-file-input" type="file" accept="image/jpeg,image/png,image/webp" data-gallery-upload={field.id} aria-label={`Upload ${field.label}`} />
                          <i data-lucide="upload"></i>
                          <span class="cms-visually-hidden">Upload image</span>
                        </label>
                        <div class="cms-media-picker" data-gallery-picker={field.id} hidden>
                          <label class="cms-picker-search">
                            <span>Media library</span>
                            <input class="cms-input" type="search" placeholder="Search media" data-gallery-picker-search={field.id} />
                          </label>
                          <div class="cms-picker-list" data-gallery-picker-list={field.id}>
                            {model.mediaAssets.map((asset) => (
                              <button class="cms-picker-option" type="button" data-gallery-picker-select={field.id} data-gallery-picker-asset={asset.assetId}>
                                <img src={asset.previewUrl} alt={asset.altText} width={asset.previewWidth} height={asset.previewHeight} />
                                <span>
                                  <strong>{asset.filename}</strong>
                                  <small>{asset.altText}</small>
                                </span>
                              </button>
                            ))}
                          </div>
                        </div>
                      </div>
                      <small class="cms-gallery-helper" data-gallery-file-name={field.id}>Drag images to reorder. Uploaded images are optimized and added immediately.</small>
                      <small>{field.primitive}</small>
                    </div>
                  ) : isMultiline(field) ? (
                    <label class="cms-field" for={`core-${field.id}`}>
                      <span>
                        {field.label}
                        {field.required && <em>Required</em>}
                      </span>
                      {field.primitive === 'richText' && (
                        <div class="cms-richtext-toolbar">
                          <select class="cms-input" data-richtext-media-select={field.id} aria-label={`Insert image into ${field.label}`}>
                            <option value="">Insert image from media</option>
                            {model.mediaAssets.map((asset) => (
                              <option value={asset.assetId}>{asset.filename}</option>
                            ))}
                          </select>
                          <button class="cms-button cms-button-secondary" type="button" data-richtext-insert-image={field.id}>Insert image</button>
                        </div>
                      )}
                      <textarea
                        class="cms-input cms-textarea"
                        id={`core-${field.id}`}
                        name={`core-${field.id}`}
                        aria-label={field.label}
                        data-field={field.id}
                      >{field.value}</textarea>
                      <small>{field.primitive}</small>
                    </label>
                  ) : (
                    <label class="cms-field" for={`core-${field.id}`}>
                      <span>
                        {field.label}
                        {field.required && <em>Required</em>}
                      </span>
                      <input
                        class="cms-input"
                        id={`core-${field.id}`}
                        name={`core-${field.id}`}
                        aria-label={field.label}
                        value={field.value}
                        data-field={field.id}
                      />
                      <small>{field.primitive}</small>
                    </label>
                  )
                ))}
              </div>
            </section>

            <section class="cms-field-section" aria-labelledby="extra-fields-heading">
              <div class="cms-subheading">
                <p class="cms-kicker">Item-specific</p>
                <h3 id="extra-fields-heading">Extra sections</h3>
              </div>

              {activeItem.extraSections.length > 0 ? (
                <div class="cms-extra-stack">
                  {activeItem.extraSections.map((section) => (
                    <article class="cms-extra-section">
                      <div class="cms-extra-title">
                        <h4>{section.label}</h4>
                        <small>{section.id}</small>
                      </div>
                      <div class="cms-fields">
                        {section.fields.map((field) => (
                          <label class="cms-field" for={`${section.id}-${field.id}`}>
                            <span>
                              {field.label}
                              {field.required && <em>Required</em>}
                            </span>
                            {isMultiline(field) ? (
                              <textarea
                                class="cms-input cms-textarea"
                                id={`${section.id}-${field.id}`}
                                name={`${section.id}-${field.id}`}
                                aria-label={field.label}
                                data-extra-section={section.id}
                                data-extra-field={field.id}
                              >{field.value}</textarea>
                            ) : (
                              <input
                                class="cms-input"
                                id={`${section.id}-${field.id}`}
                                name={`${section.id}-${field.id}`}
                                aria-label={field.label}
                                value={field.value}
                                data-extra-section={section.id}
                                data-extra-field={field.id}
                              />
                            )}
                            <small>{field.primitive}</small>
                          </label>
                        ))}
                      </div>
                    </article>
                  ))}
                </div>
              ) : (
                <div class="cms-empty-state">
                  <strong>No extra sections on this item.</strong>
                  <p>This item only needs the shared schema for its collection.</p>
                </div>
              )}
            </section>
          </form>
        )}
      </section>

      <aside class="cms-rail" aria-label="Publishing state">
        <section class="cms-rail-section">
          <p class="cms-kicker">{isSettingsMode || isUsersMode ? 'Access state' : 'Draft state'}</p>
          <h2 data-status-text>{statusLabel}</h2>
          <p data-status-helper>
            {isSettingsMode || isUsersMode
              ? 'Logged-in users should only see the tools their role allows.'
              : 'Autosave protects edits. Publish is the moment content becomes live.'}
          </p>
          {!isSettingsMode && !isUsersMode && <button class="cms-button" type="button" data-publish-button disabled>Publish</button>}
        </section>

        <section class="cms-rail-section">
          <p class="cms-kicker">Source of truth</p>
          <p>
            {isMediaMode
              ? 'Media metadata and optimized image variants are stored separately. Published pages should reference optimized assets only.'
              : isSettingsMode
              ? 'Site settings belong to the site, not an individual page or collection item.'
              : isUsersMode
              ? 'Users are global identities with site-specific roles, so support access and client access stay separate.'
              : isPagesMode
              ? 'On-page copy is edited visually from the page itself. This screen only stores page settings and SEO.'
              : 'Editing this item changes the collection source globally. Pages that pull this content should use the updated source on publish.'}
          </p>
        </section>

        {isPagesMode && activePage && (
          <section class="cms-rail-section">
            <p class="cms-kicker">Visual editing</p>
            <p>Open the page to edit headings, paragraphs, buttons, images, and other visible static content in context.</p>
            <a class="cms-button cms-button-secondary" href={activePage.editHref}>Edit page</a>
          </section>
        )}

        <section class="cms-rail-section">
          <p class="cms-kicker">{isSettingsMode || isUsersMode ? 'Account context' : 'Content contract'}</p>
          <dl class="cms-contract-list">
            {isSettingsMode ? (
              <>
                <div>
                  <dt>Site</dt>
                  <dd>{model.siteSettings?.siteId}</dd>
                </div>
                <div>
                  <dt>Domain</dt>
                  <dd>{model.siteSettings?.domain}</dd>
                </div>
                <div>
                  <dt>Support</dt>
                  <dd>{model.siteSettings?.supportAccessVisible ? 'Visible' : 'Hidden'}</dd>
                </div>
              </>
            ) : isUsersMode ? (
              <>
                <div>
                  <dt>Signed in</dt>
                  <dd>{currentUser?.name}</dd>
                </div>
                <div>
                  <dt>Role</dt>
                  <dd>{currentUser?.roleLabel}</dd>
                </div>
                <div>
                  <dt>Users</dt>
                  <dd>{model.auth.users.length}</dd>
                </div>
              </>
            ) : isPagesMode ? (
              <>
                <div>
                  <dt>Page</dt>
                  <dd>{activePage?.id}</dd>
                </div>
                <div>
                  <dt>Path</dt>
                  <dd>{activePage?.path}</dd>
                </div>
                <div>
                  <dt>Settings</dt>
                  <dd>{activePage?.fields.length ?? 0}</dd>
                </div>
              </>
            ) : isMediaMode ? (
              <>
                <div>
                  <dt>Assets</dt>
                  <dd data-media-count>{model.mediaAssets.length}</dd>
                </div>
                <div>
                  <dt>Format</dt>
                  <dd>WebP</dd>
                </div>
                <div>
                  <dt>Originals</dt>
                  <dd>Discarded</dd>
                </div>
              </>
            ) : (
              <>
                <div>
                  <dt>Collection</dt>
                  <dd>{activeCollection?.id}</dd>
                </div>
                <div>
                  <dt>Core fields</dt>
                  <dd>{activeItem?.fields.length ?? 0}</dd>
                </div>
                <div>
                  <dt>Extra sections</dt>
                  <dd>{activeItem?.extraSections.length ?? 0}</dd>
                </div>
              </>
            )}
          </dl>
        </section>
      </aside>
    </main>

    <script>
      import '../cms/client';
    </script>
  </body>
</html>
